SITE_URL=http://127.0.0.1:8080
REQUEST_TOKEN=request_token
# Сайты, с которых браузеру разрешено вызывать API (через запятую). По умолчанию — SITE_URL
ALLOWED_ORIGINS=http://127.0.0.1:8080
# Ключи серверных клиентов (Планфикс) для заголовка X-API-Key, через запятую
API_KEYS=
BOT_TOKEN=
# Прокси для Telegram-бота, напр. socks5://user:pass@host:1080 или http://host:3128
BOT_PROXY_URL=
# Username бота без @ — для кнопки «Вернуться в бота» на страницах редиректа оплаты
BOT_USERNAME=
# Секрет для подписи ссылок кнопок оплаты (/tg/go). Без него кнопки тарифов в боте не строятся
BOT_LINK_SECRET=
# URL стороннего сервиса-распределителя запросов (если задан — ссылки бота ведут туда
# вместо SITE_URL). Требует, чтобы BOT_LINK_SECRET совпадал на всех участвующих хостах.
BOT_DISPATCHER_URL=
# Путь к JSON со списком тарифов (по умолчанию app_bot/tariffs.json)
BOT_TARIFFS_CONFIG=
# Способ получения обновлений: polling (по умолчанию) или webhook. Переопределяется `python -m bot run --mode`
BOT_UPDATE_MODE=polling
# Для webhook: публичный URL (без пути), путь, адрес/порт встроенного сервера и секрет заголовка X-Telegram-Bot-Api-Secret-Token
BOT_WEBHOOK_URL=
BOT_WEBHOOK_PATH=bot/webhook
BOT_WEBHOOK_LISTEN=0.0.0.0
BOT_WEBHOOK_PORT=8443
BOT_WEBHOOK_SECRET=
# Redis для состояния бота (redis://[:password@]host:6379/0). Если не задан — состояние в памяти процесса
REDIS_URL=
# Префикс ключей в Redis и время жизни состояния пользователя в секундах
BOT_STATE_KEY_PREFIX=bot
BOT_STATE_TTL=86400

TBANK_TERMINAL_ID=1234567890
TBANK_TERMINAL_PASSWORD=terminal_password
# В URL успеха можно использовать плейсхолдер {task_id} — он будет заменён на id задачи (если плейсхолдера нет, строка не меняется).
TBANK_USE_SUCCESS_PAYMENT_REDIRECT_URL=https://my-site/task/{task_id}/success/
TBANK_USE_FAIL_PAYMENT_REDIRECT_URL=https://my-site/error.html

YOOKASSA_ACCOUNT_ID="account_id"
YOOKASSA_TOKEN="live_token"
YOOKASSA_USE_SUCCESS_PAYMENT_REDIRECT_URL="https://my-site/task/{task_id}/success/"

PLANFIX_ACCOUNT=aspectgroup
PLANFIX_TOKEN=planfix_token
DEFAULT_PAYMENT_DEADLINE=30
DEFAULT_RATE_LIMIT=50/minute
PAYMENT_INIT_RATE_LIMIT=20/minute

# WATA
WATA_TOKEN=
WATA_USE_SUCCESS_PAYMENT_REDIRECT_URL=https://my-site/task/{task_id}/success/
WATA_USE_FAIL_PAYMENT_REDIRECT_URL=https://my-site/error.html

# PLATEGA
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
# Метод оплаты: 2 — СБП, 3 — ЕРИП, 11 — карты, 12 — международная оплата, 13 — криптовалюта, 14 — SberPay.
# Пусто — клиент выбирает способ оплаты на странице Platega
PLATEGA_PAYMENT_METHOD=
PLATEGA_USE_SUCCESS_PAYMENT_REDIRECT_URL=https://my-site/task/{task_id}/success/
PLATEGA_USE_FAIL_PAYMENT_REDIRECT_URL=https://my-site/error.html

# S3
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_ENDPOINT_URL=https://storage.yandexcloud.net/
