VITE_BASE_URL=http://127.0.0.1:8000
VITE_APP_POOLING_INTERVAL=1500

# Dummy config: true — dummy success page and public offer, false — VPN (default)
VITE_USE_DUMMY_CONFIG=false

# Application Store Links
# Android
VITE_APP_LINK_ANDROID=https://play.google.com/store/apps/details?id=com.happproxy

# iPhone / iPad
VITE_APP_LINK_IPHONE_US=https://apps.apple.com/us/app/happ-proxy-utility/id6504287215
VITE_APP_LINK_IPHONE_RU=https://apps.apple.com/ru/app/happ-proxy-utility-plus/id6746188973

# Windows
VITE_APP_LINK_WINDOWS=https://github.com/Happ-proxy/happ-desktop/releases/latest/download/setup-Happ.x64.exe

# macOS
VITE_APP_LINK_MAC_US=https://apps.apple.com/us/app/happ-proxy-utility/id6504287215
VITE_APP_LINK_MAC_RU=https://apps.apple.com/ru/app/happ-proxy-utility-plus/id6746188973

# Карта источников оплаты: пары source:шлюз через запятую.
# Шлюз — platega, wata или yookassa. Ключ без учёта регистра.
# Пустая или кривая пара пропускается. Пустое значение — дефолт в коде.
# Значение вшивается при сборке.
VITE_PAYMENT_SOURCE_MAP=vk:platega,wa:wata,pf:platega,tg:wata

# Source для редиректа устаревших адресов /task/ и /payment/app/tariffs/.
# Без учёта регистра. Пустое значение — pf. Если кода нет в карте, редиректа нет.
# Значение вшивается при сборке.
VITE_DEPRECATED_URL_SOURCE=pf

